#!/usr/bin/env bash
set -Eeuo pipefail
while true; do
 choice="$(zenity --list --title="HARDIK OS" --text="Your desktop control center" --column="HARDIK" "App Center" "Security Center" "System Settings" "File Manager" "Terminal" "Calendar" "About HARDIK OS" --width=560 --height=420)" || exit 0
 case "$choice" in
  "App Center") hardik-app-center ;;
  "Security Center") hardik-security-center ;;
  "System Settings") lxqt-config >/dev/null 2>&1 & ;;
  "File Manager") pcmanfm-qt >/dev/null 2>&1 & ;;
  "Terminal") qterminal >/dev/null 2>&1 & ;;
  "Calendar") gsimplecal >/dev/null 2>&1 & ;;
  "About HARDIK OS") zenity --info --title="About HARDIK OS" --width=480 --text="HARDIK OS 0.6.0\nDebian 13 Trixie • amd64\n\nLXQt desktop, SDDM login, animated Plymouth boot splash, Plank dock, live system monitor, Chrome, app manager and security tools.\n\nExperimental development build; hardware compatibility and installation require testing." ;;
 esac
done
