#!/usr/bin/python3
import configparser,re,shlex,subprocess,sys
from pathlib import Path
from PyQt6.QtCore import Qt,QTimer,QProcess
from PyQt6.QtGui import QIcon,QKeySequence,QShortcut
from PyQt6.QtWidgets import QApplication,QWidget,QDialog,QLabel,QPushButton,QLineEdit,QListWidget,QListWidgetItem,QVBoxLayout,QHBoxLayout
STYLE="""QWidget{color:#edf5ff;font-family:Inter,'Noto Sans',sans-serif;} QWidget#bar{background:rgba(5,7,13,242);border-bottom:1px solid #12384a;} QPushButton{background:transparent;border:0;border-radius:9px;padding:7px 11px;color:#dce8f5;} QPushButton:hover{background:#122333;color:#00d9ff;} QLineEdit{background:#0c1420;border:1px solid #244154;border-radius:13px;padding:12px 16px;color:#fff;font-size:15px;} QListWidget{background:transparent;border:0;outline:0;} QListWidget::item{padding:9px;border-radius:8px;} QListWidget::item:selected{background:#123244;color:#00d9ff;} QDialog{background:#05070d;} QLabel#muted{color:#8da4b9;} QLabel#brand{color:#00d9ff;font-weight:700;letter-spacing:2px;}"""
def launch(command):
 command=re.sub(r"%[fFuUdDnNickvm]","",command or "").strip()
 try:
  p=shlex.split(command)
  if p and QProcess.startDetached(p[0],p[1:]): return
  raise RuntimeError("Application command could not be started: "+command)
 except Exception as e:
  QProcess.startDetached("zenity",["--error","--title=HARDIK OS","--text="+str(e)])
def output(*args):
 try:return subprocess.run(args,capture_output=True,text=True,timeout=3).stdout.strip()
 except Exception:return ""
def application_entries():
 found={}
 roots=[Path("/usr/share/applications"),Path("/usr/local/share/applications"),Path.home()/".local/share/applications"]
 for root in roots:
  if not root.exists():continue
  for path in root.glob("*.desktop"):
   try:
    cfg=configparser.RawConfigParser(interpolation=None,strict=False);cfg.read(path,encoding="utf-8")
    if not cfg.has_section("Desktop Entry"):continue
    sec=cfg["Desktop Entry"]
    if sec.get("NoDisplay","false").lower()=="true" or sec.get("Hidden","false").lower()=="true":continue
    name,command=sec.get("Name",path.stem),sec.get("Exec","")
    if command and name not in found:found[name]={"name":name,"exec":command,"icon":sec.get("Icon","application-x-executable"),"categories":sec.get("Categories","").lower()}
   except Exception:continue
 return sorted(found.values(),key=lambda x:x["name"].casefold())
CATEGORIES=[("All applications",""),("Internet","network;web;"),("Development","development;"),("Multimedia","audio;video;graphics;"),("Games","game;"),("System tools","system;settings;"),("Utilities","utility;accessibility;")]
class Launcher(QDialog):
 def __init__(self):
  super().__init__();self.setWindowFlags(Qt.WindowType.FramelessWindowHint|Qt.WindowType.WindowStaysOnTopHint);self.setStyleSheet(STYLE);self.entries=application_entries();self.category=""
  root=QVBoxLayout(self);root.setContentsMargins(65,45,65,45);head=QHBoxLayout();brand=QLabel("⬡ HARDIK OS");brand.setObjectName("brand");head.addWidget(brand);head.addStretch();close=QPushButton("✕");close.clicked.connect(self.hide);head.addWidget(close);root.addLayout(head)
  self.search=QLineEdit();self.search.setPlaceholderText("Search applications…");self.search.textChanged.connect(self.refresh);root.addWidget(self.search);body=QHBoxLayout();self.categories=QListWidget();self.categories.setFixedWidth(205)
  for title,key in CATEGORIES:
   item=QListWidgetItem(title);item.setData(Qt.ItemDataRole.UserRole,key);self.categories.addItem(item)
  self.categories.currentRowChanged.connect(self.select_category);body.addWidget(self.categories);self.apps=QListWidget();self.apps.setViewMode(QListWidget.ViewMode.IconMode);self.apps.setResizeMode(QListWidget.ResizeMode.Adjust);self.apps.setMovement(QListWidget.Movement.Static);self.apps.itemActivated.connect(self.open_selected);self.apps.itemDoubleClicked.connect(self.open_selected);body.addWidget(self.apps,1);root.addLayout(body,1);root.addWidget(QLabel("Search • Categories • Keyboard navigation"));QShortcut(QKeySequence("Escape"),self,activated=self.hide);self.categories.setCurrentRow(0);self.refresh()
 def select_category(self,row):
  if row>=0:self.category=self.categories.item(row).data(Qt.ItemDataRole.UserRole);self.refresh()
 def refresh(self):
  query=self.search.text().casefold();self.apps.clear()
  for entry in self.entries:
   if query and query not in entry["name"].casefold():continue
   if self.category and self.category not in entry["categories"]:continue
   item=QListWidgetItem(QIcon.fromTheme(entry["icon"]),entry["name"]);item.setData(Qt.ItemDataRole.UserRole,entry);self.apps.addItem(item)
 def open_selected(self,item):
  entry=item.data(Qt.ItemDataRole.UserRole)
  if entry:launch(entry["exec"]);self.hide()
class QuickPanel(QDialog):
 def __init__(self,parent):
  super().__init__(parent);self.setWindowFlags(Qt.WindowType.FramelessWindowHint|Qt.WindowType.Tool|Qt.WindowType.WindowStaysOnTopHint);self.setStyleSheet(STYLE+"QDialog{background:#070b13;border:1px solid #16445a;border-radius:18px;}");self.setFixedSize(360,450);root=QVBoxLayout(self);root.setContentsMargins(20,18,20,18);root.addWidget(QLabel("Quick settings"));self.stats=QLabel("System status");root.addWidget(self.stats)
  for label,cmd,args in [("Network settings","systemsettings",["kcm_networkmanagement"]),("Sound settings","pavucontrol",[]),("Display settings","systemsettings",["kcm_kscreen"]),("System monitor","plasma-systemmonitor",[])]:
   b=QPushButton(label);b.clicked.connect(lambda checked=False,c=cmd,a=args:QProcess.startDetached(c,a));root.addWidget(b)
  root.addStretch()
class TopBar(QWidget):
 def __init__(self):
  super().__init__();self.setObjectName("bar");self.setWindowFlags(Qt.WindowType.FramelessWindowHint|Qt.WindowType.WindowStaysOnTopHint|Qt.WindowType.Dock);self.setStyleSheet(STYLE);screen=QApplication.primaryScreen().availableGeometry();self.setGeometry(screen.x(),screen.y(),screen.width(),44);row=QHBoxLayout(self);row.setContentsMargins(18,2,18,2);logo=QPushButton("⬡ HARDIK");logo.setStyleSheet("color:#00d9ff;font-weight:800;");logo.clicked.connect(lambda:QProcess.startDetached("hardik-center"));row.addWidget(logo);apps=QPushButton("▦ Apps");apps.clicked.connect(self.show_launcher);row.addWidget(apps);row.addStretch();self.clock=QLabel();row.addWidget(self.clock);row.addStretch();quick=QPushButton("☷ Quick");quick.clicked.connect(self.show_quick);row.addWidget(quick);self.launcher_dialog=Launcher();self.quick_panel=QuickPanel(self);self.timer=QTimer(self);self.timer.timeout.connect(self.update_clock);self.timer.start(1000);self.update_clock()
 def update_clock(self):
  from datetime import datetime
  self.clock.setText(datetime.now().strftime("%a %d %b • %H:%M"))
 def show_launcher(self):self.launcher_dialog.showFullScreen();self.launcher_dialog.search.setFocus()
 def show_quick(self):self.quick_panel.move(self.x()+self.width()-self.quick_panel.width()-18,50);self.quick_panel.show();self.quick_panel.raise_()
def main():
 app=QApplication(sys.argv);app.setApplicationName("HARDIK Desktop Shell");bar=TopBar();bar.show()
 if "--launcher" in sys.argv:bar.show_launcher()
 sys.exit(app.exec())
if __name__=="__main__":main()
