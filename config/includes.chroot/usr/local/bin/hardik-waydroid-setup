#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $EUID -ne 0 ]]; then
  exec pkexec "$0" "$@"
fi
if ! grep -qE 'binder_linux|binder' /proc/filesystems 2>/dev/null && [[ ! -e /dev/binderfs ]]; then
  zenity --warning --title="Android compatibility" --width=520 \
    --text="This kernel does not currently expose Android Binder. Waydroid cannot start until binder support is available. This is a hardware/kernel capability check, not an OS error."
fi
if ! command -v curl >/dev/null; then
  zenity --error --text="curl is required."; exit 1
fi
if ! zenity --question --title="Install Waydroid" --width=520 \
  --text="Waydroid downloads a separate Android system image and needs compatible Binder kernel support. Continue with the official Waydroid repository setup?"; then
  exit 0
fi
curl -fsSL https://repo.waydro.id | bash
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y waydroid
waydroid init
zenity --info --title="Waydroid setup" --width=520 \
  --text="Waydroid packages and Android image setup have been requested. Reboot, then launch Waydroid from the applications menu. It may not work on every kernel or GPU."
