#!/usr/bin/env bash
set -Eeuo pipefail

echo "HARDIK OS: applying desktop branding and baseline security configuration"

cat > /etc/os-release <<'EOF'
PRETTY_NAME="HARDIK OS 0.4.0 (Development Build)"
NAME="HARDIK OS"
VERSION="0.4.0"
VERSION_ID="0.4.0"
ID=hardik
ID_LIKE=ubuntu
UBUNTU_CODENAME=noble
EOF
cat > /etc/issue <<'EOF'
HARDIK OS 0.4.0 — Development Build
Ubuntu-based • amd64
EOF

install -d /etc/skel/.config/autostart /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml /etc/skel/Desktop
install -d /etc/xdg/picom
chmod 0755 /usr/local/bin/hardik-center /usr/local/bin/hardik-security-report /usr/local/bin/hardik-app-center /usr/local/bin/hardik-waydroid-setup /usr/local/bin/hardik-security-center

cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
 <property name="Net" type="empty">
  <property name="ThemeName" type="string" value="Arc-Dark"/>
  <property name="IconThemeName" type="string" value="Papirus-Dark"/>
 </property>
 <property name="Gtk" type="empty">
  <property name="CursorThemeName" type="string" value="Adwaita"/>
  <property name="FontName" type="string" value="Inter 10"/>
 </property>
</channel>
EOF
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
 <property name="backdrop" type="empty">
  <property name="screen0" type="empty">
   <property name="monitor0" type="empty">
    <property name="image-path" type="string" value="/usr/share/backgrounds/hardik-wallpaper.svg"/>
    <property name="image-style" type="int" value="5"/>
   </property>
  </property>
 </property>
</channel>
EOF
cat > /etc/skel/.config/autostart/plank.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK Dock
Exec=plank
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
EOF
cat > /etc/skel/.config/autostart/picom.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK Compositor
Exec=picom --config /etc/xdg/picom.conf
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
EOF
cat > /etc/skel/.config/autostart/conky.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK System Monitor
Exec=conky --config=/etc/xdg/conky/conky.conf
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
EOF
cat > /etc/xdg/picom.conf <<'EOF'
backend = "xrender";
vsync = true;
shadow = true;
shadow-radius = 14;
shadow-opacity = 0.30;
fading = true;
fade-in-step = 0.03;
fade-out-step = 0.03;
EOF

# Install launchers into every new user's desktop.
for desktop in hardik-center hardik-app-center hardik-security-center hardik-waydroid; do
  case "$desktop" in
    hardik-center) file=/usr/share/applications/hardik-center.desktop ;;
    hardik-app-center) file=/usr/share/applications/hardik-app-center.desktop ;;
    hardik-security-center) file=/usr/share/applications/hardik-security-center.desktop ;;
    hardik-waydroid) file=/usr/share/applications/hardik-waydroid.desktop ;;
  esac
  if [ -f "$file" ]; then cp "$file" /etc/skel/Desktop/; chmod 0755 "/etc/skel/Desktop/$(basename "$file")"; fi
done

# Default-deny inbound firewall. It is enabled on installed systems at first boot.
if [ -f /etc/default/ufw ]; then
  sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' /etc/default/ufw
  sed -i 's/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' /etc/default/ufw
  sed -i 's/^DEFAULT_FORWARD_POLICY=.*/DEFAULT_FORWARD_POLICY="DROP"/' /etc/default/ufw
  sed -i 's/^IPV6=.*/IPV6=yes/' /etc/default/ufw
fi
if [ -f /etc/ufw/ufw.conf ]; then sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf; fi

systemctl enable ufw.service
systemctl enable apparmor.service
systemctl enable auditd.service
systemctl enable unattended-upgrades.service
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF

install -d -m 0755 /var/lib/hardik-os
printf '%s\n' "branding-hook=executed" "version=0.4.0" "desktop=xfce-plank-picom-conky" > /var/lib/hardik-os/build-hooks
