#!/usr/bin/env bash
set -Eeuo pipefail

echo "HARDIK OS: applying branding and baseline security configuration"

cat > /etc/os-release <<'EOF'
PRETTY_NAME="HARDIK OS 0.3.0 (Development Build)"
NAME="HARDIK OS"
VERSION="0.3.0"
VERSION_ID="0.3.0"
ID=hardik
ID_LIKE=ubuntu
UBUNTU_CODENAME=noble
EOF

cat > /etc/issue <<'EOF'
HARDIK OS 0.3.0 — Development Build
Ubuntu-based • amd64
EOF

mkdir -p /etc/skel/.config/autostart /etc/skel/Desktop
mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml
chmod 0755 /usr/local/bin/hardik-center /usr/local/bin/hardik-security-report

cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Arc-Dark"/>
    <property name="IconThemeName" type="string" value="Papirus-Dark"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="CursorThemeName" type="string" value="Adwaita"/>
    <property name="FontName" type="string" value="Inter 10"/>
  </property>
</channel>
EOF

cat > /etc/skel/.config/autostart/plank.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK Dock
Exec=plank
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
EOF

cat > /etc/skel/.config/autostart/picom.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK Compositor
Exec=picom --config /etc/xdg/picom.conf
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
EOF

cat > /etc/xdg/picom.conf <<'EOF'
backend = "glx";
vsync = true;
shadow = true;
shadow-radius = 14;
shadow-opacity = 0.28;
fading = true;
fade-in-step = 0.03;
fade-out-step = 0.03;
EOF

# Deny unsolicited inbound traffic while retaining normal outbound access.
if [ -f /etc/default/ufw ]; then
  sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' /etc/default/ufw
  sed -i 's/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' /etc/default/ufw
  sed -i 's/^DEFAULT_FORWARD_POLICY=.*/DEFAULT_FORWARD_POLICY="DROP"/' /etc/default/ufw
  sed -i 's/^IPV6=.*/IPV6=yes/' /etc/default/ufw
fi

if [ -f /etc/ufw/ufw.conf ]; then
  sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
fi

# Enable services in the image without starting daemons in the build chroot.
systemctl enable ufw.service
systemctl enable apparmor.service
systemctl enable unattended-upgrades.service

cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF

if [ -f /usr/share/applications/hardik-center.desktop ]; then
  cp /usr/share/applications/hardik-center.desktop /etc/skel/Desktop/
  chmod 0755 /etc/skel/Desktop/hardik-center.desktop
fi

# Leave an auditable marker proving this local chroot hook ran.
install -d -m 0755 /var/lib/hardik-os
printf '%s\n' "branding-hook=executed" "version=0.3.0" > /var/lib/hardik-os/build-hooks
