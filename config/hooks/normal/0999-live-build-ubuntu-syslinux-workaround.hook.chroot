#!/bin/sh
set -eu

# Ubuntu-mode live-build unconditionally extracts this archive during the
# Syslinux stage, even when --syslinux-theme live-build is selected.
# The live-build theme does not use Ubuntu gfxboot artwork, so provide a
# valid empty tar archive to satisfy that legacy extraction step.
mkdir -p /usr/share/gfxboot-theme-ubuntu
tar -czf /usr/share/gfxboot-theme-ubuntu/bootlogo.tar.gz --files-from /dev/null
test -s /usr/share/gfxboot-theme-ubuntu/bootlogo.tar.gz
