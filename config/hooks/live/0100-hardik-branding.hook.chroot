#!/usr/bin/env bash
set -Eeuo pipefail
cat > /etc/os-release <<'EOF'
PRETTY_NAME="HARDIK OS 0.5.0 (Debian 13 Trixie)"
NAME="HARDIK OS"
VERSION="0.5.0"
VERSION_ID="0.5.0"
ID=hardik
ID_LIKE=debian
VERSION_CODENAME=trixie
DEBIAN_CODENAME=trixie
EOF
printf '%s\n' "HARDIK OS 0.5.0 — Debian 13 Trixie • amd64" > /etc/issue
install -d /etc/skel/.config/autostart /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml /etc/skel/.config/xfce4/terminal /etc/skel/.config/plank/dock1/launchers /etc/skel/Desktop /etc/xdg/conky
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
 <property name="Net" type="empty">
  <property name="ThemeName" type="string" value="Arc-Dark"/>
  <property name="IconThemeName" type="string" value="Papirus-Dark"/>
 </property>
 <property name="Gtk" type="empty">
  <property name="CursorThemeName" type="string" value="Adwaita"/>
  <property name="FontName" type="string" value="Inter 10"/>
 </property>
</channel>
EOF
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
 <property name="backdrop" type="empty">
  <property name="screen0" type="empty">
   <property name="monitor0" type="empty">
    <property name="image-path" type="string" value="/usr/share/backgrounds/hardik-wallpaper.svg"/>
    <property name="image-style" type="int" value="5"/>
   </property>
  </property>
 </property>
</channel>
EOF
cat > /etc/skel/.config/xfce4/terminal/terminalrc <<'EOF'
[Configuration]
FontName=Inter 11
MiscMenubarDefault=FALSE
MiscToolbarDefault=FALSE
ColorForeground=#8BE9E5
ColorBackground=#0B121A
ColorCursor=#00E5D4
EOF
cat > /etc/xdg/picom.conf <<'EOF'
backend = "xrender";
vsync = true;
shadow = true;
shadow-radius = 18;
shadow-opacity = 0.34;
fading = true;
fade-in-step = 0.035;
fade-out-step = 0.035;
inactive-opacity = 0.94;
active-opacity = 0.98;
EOF
cat > /etc/skel/.config/autostart/plank.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK Dock
Exec=plank
OnlyShowIn=XFCE;
EOF
cat > /etc/skel/.config/autostart/picom.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK Glass Effects
Exec=picom --config /etc/xdg/picom.conf
OnlyShowIn=XFCE;
EOF
cat > /etc/skel/.config/autostart/conky.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK System Monitor
Exec=conky --config=/etc/xdg/conky/conky.conf
OnlyShowIn=XFCE;
EOF
# Plank launchers are keyfiles pointing at installed desktop entries.
write_dock_item() {
 name="$1"
 desktop="$2"
 cat > "/etc/skel/.config/plank/dock1/launchers/$name.dockitem" <<EOF
[PlankDockItemPreferences]
Launcher=file:///usr/share/applications/$desktop
EOF
}
write_dock_item files thunar.desktop
write_dock_item terminal xfce4-terminal.desktop
write_dock_item calendar hardik-calendar.desktop
write_dock_item center hardik-center.desktop
write_dock_item software org.gnome.Software.desktop
cat > /etc/skel/.config/plank/dock1/settings <<'EOF'
[PlankDockPreferences]
Alignment=3
IconSize=48
ItemsAlignment=1
Position=3
Theme=Gtk+
ZoomEnabled=true
ZoomPercent=130
EOF
if [ -f /etc/default/ufw ]; then
 sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' /etc/default/ufw
 sed -i 's/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' /etc/default/ufw
 sed -i 's/^DEFAULT_FORWARD_POLICY=.*/DEFAULT_FORWARD_POLICY="DROP"/' /etc/default/ufw
fi
if [ -f /etc/ufw/ufw.conf ]; then sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf; fi
systemctl enable ufw.service apparmor.service auditd.service unattended-upgrades.service
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF
install -d -m 0755 /var/lib/hardik-os
printf '%s\n' "version=0.5.0" "base=debian-trixie" > /var/lib/hardik-os/build-hooks
