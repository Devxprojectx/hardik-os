#!/usr/bin/env bash
set -Eeuo pipefail
VERSION="0.8.0"
cat > /etc/os-release <<EOF
PRETTY_NAME="HARDIK OS ${VERSION} (Debian 13 Trixie)"
NAME="HARDIK OS"
VERSION="${VERSION}"
VERSION_ID="${VERSION}"
ID=hardik
ID_LIKE=debian
VERSION_CODENAME=trixie
DEBIAN_CODENAME=trixie
EOF
printf '%s\n' "HARDIK OS ${VERSION} — Debian 13 Trixie • amd64" > /etc/issue

install -d /etc/skel/.config/autostart /etc/skel/.config/gtk-3.0 \
  /etc/sddm.conf.d /etc/plymouth/themes/hardik \
  /usr/share/icons/hicolor/scalable/apps /usr/share/backgrounds \
  /usr/local/sbin /etc/systemd/system/graphical.target.wants /var/lib/hardik-os

cat > /etc/skel/.config/kdeglobals <<'EOF'
[General]
ColorScheme=BreezeDark
Name=HARDIK OS
[KDE]
LookAndFeelPackage=org.kde.breezedark.desktop
[Icons]
Theme=Papirus-Dark
[WM]
activeBackground=5,8,16
activeForeground=245,248,255
inactiveBackground=8,10,16
inactiveForeground=180,190,205
EOF
cat > /etc/skel/.config/kwinrc <<'EOF'
[Compositing]
Enabled=true
Backend=OpenGL
GLCore=true
AnimationSpeed=2
[Plugins]
blurEnabled=true
contrastEnabled=true
fadeEnabled=true
minimizeanimationEnabled=true
slideEnabled=true
[Windows]
BorderlessMaximizedWindows=true
[org.kde.kdecoration2]
ButtonsOnLeft=
ButtonsOnRight=IAX
EOF
cat > /etc/skel/.config/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-theme-name=Breeze-Dark
gtk-icon-theme-name=Papirus-Dark
gtk-font-name=Inter 10
gtk-cursor-theme-name=Adwaita
EOF

if [ -f /usr/share/backgrounds/hardik-logo.svg ]; then
  cp /usr/share/backgrounds/hardik-logo.svg /usr/share/icons/hicolor/scalable/apps/hardik-logo.svg
  rsvg-convert -w 512 -h 512 /usr/share/backgrounds/hardik-logo.svg -o /etc/plymouth/themes/hardik/hardik-logo.png
fi
cat > /etc/plymouth/themes/hardik/hardik.plymouth <<'EOF'
[Plymouth Theme]
Name=HARDIK OS
Description=HARDIK shield logo with electric energy ring
ModuleName=script
[script]
ImageDir=/etc/plymouth/themes/hardik
ScriptFile=/etc/plymouth/themes/hardik/hardik.script
EOF
cat > /etc/plymouth/themes/hardik/hardik.script <<'EOF'
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
logo_image = Image("hardik-logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - logo_image.GetWidth() / 2,
                        Window.GetY() + Window.GetHeight() / 2 - logo_image.GetHeight() / 2);
fun refresh_callback() {
    t = Plymouth.GetTime();
    pulse = 0.78 + 0.22 * Math.Sin(t * 2.2);
    logo_sprite.SetOpacity(pulse);
}
Plymouth.SetRefreshFunction(refresh_callback);
EOF
if command -v plymouth-set-default-theme >/dev/null 2>&1 && [ -s /etc/plymouth/themes/hardik/hardik-logo.png ]; then
  plymouth-set-default-theme hardik || true
  update-initramfs -u -k all || true
fi

# Live USB auto-login only. The guard removes this setting on installed systems.
cat > /etc/sddm.conf.d/10-hardik-live.conf <<'EOF'
[Autologin]
User=hardik
Session=plasma.desktop
Relogin=false
EOF
cat > /etc/sddm.conf.d/20-hardik-theme.conf <<'EOF'
[Theme]
Current=breeze
EOF
if [ -d /usr/share/sddm/themes/breeze ]; then
  cat > /usr/share/sddm/themes/breeze/theme.conf.user <<'EOF'
[General]
background=/usr/share/backgrounds/hardik-wallpaper.svg
EOF
fi
cat > /usr/local/sbin/hardik-login-guard <<'EOF'
#!/bin/sh
if [ ! -d /run/live/medium ]; then
  rm -f /etc/sddm.conf.d/10-hardik-live.conf
fi
exit 0
EOF
chmod 0755 /usr/local/sbin/hardik-login-guard
cat > /etc/systemd/system/hardik-login-guard.service <<'EOF'
[Unit]
Description=HARDIK OS live-session autologin guard
DefaultDependencies=no
After=local-fs.target
Before=sddm.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hardik-login-guard
RemainAfterExit=yes
[Install]
WantedBy=graphical.target
EOF
ln -sf /etc/systemd/system/hardik-login-guard.service /etc/systemd/system/graphical.target.wants/hardik-login-guard.service
systemctl enable sddm.service 2>/dev/null || true
systemctl set-default graphical.target 2>/dev/null || true

if [ -f /etc/calamares/settings.conf ]; then
  brand="$(awk '/^[[:space:]]*branding:[[:space:]]*/ {print $2; exit}' /etc/calamares/settings.conf)"
  src=""
  if [ -n "$brand" ] && [ -d "/usr/share/calamares/branding/$brand" ]; then
    src="/usr/share/calamares/branding/$brand"
  elif [ -n "$brand" ] && [ -d "/etc/calamares/branding/$brand" ]; then
    src="/etc/calamares/branding/$brand"
  else
    desc="$(find /usr/share/calamares/branding /etc/calamares/branding -mindepth 2 -maxdepth 2 -name branding.desc -print -quit 2>/dev/null || true)"
    [ -z "$desc" ] || src="$(dirname "$desc")"
  fi
  if [ -n "$src" ] && [ -f "$src/branding.desc" ]; then
    install -d /etc/calamares/branding/hardik
    cp -a "$src/." /etc/calamares/branding/hardik/
    sed -i 's/^branding:.*/branding: hardik/' /etc/calamares/settings.conf
    sed -i 's/Debian GNU\/Linux/HARDIK OS/g' /etc/calamares/branding/hardik/branding.desc || true
    cat > /etc/calamares/branding/hardik/stylesheet.qss <<'EOF'
QWidget { background: #05070d; color: #edf5ff; selection-background-color: #00d9ff; selection-color: #02050a; }
QMainWindow, QDialog { background: #05070d; }
QPushButton { background: #101725; color: #f4f8ff; border: 1px solid #183d50; border-radius: 9px; padding: 9px 16px; }
QPushButton:hover { border: 1px solid #00d9ff; background: #102433; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit { background: #0b111c; color: #f4f8ff; border: 1px solid #203548; border-radius: 7px; padding: 7px; }
QProgressBar { background: #101725; border: 1px solid #203548; border-radius: 6px; text-align: center; color: #fff; }
QProgressBar::chunk { background: #00d9ff; border-radius: 5px; }
QListView, QTreeView, QTableView { background: #080d16; alternate-background-color: #0e1724; border: 1px solid #203548; }
EOF
  fi
fi

# Keep the standard KDE Plasma desktop and its normal panel/launcher.
# Do not replace Plasma panels or start custom overlays, docks, or widgets.
rm -f /etc/skel/.config/autostart/hardik-shell.desktop
rm -f /etc/skel/.config/autostart/conky.desktop
rm -f /etc/skel/.config/autostart/plank.desktop
rm -f /usr/share/applications/hardik-center.desktop
rm -f /usr/share/applications/hardik-store.desktop
rm -f /usr/share/applications/hardik-security-center.desktop
rm -f /usr/share/applications/hardik-launcher.desktop

cat > /usr/share/applications/hardik-installer.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Install HARDIK OS
Comment=Install HARDIK OS to this computer
Exec=pkexec calamares
Icon=hardik-logo
Categories=System;
Terminal=false
EOF


cat > /etc/xdg/conky/conky.conf <<'EOF'
conky.config = {
  alignment = 'top_left',
  background = true,
  double_buffer = true,
  own_window = true,
  own_window_type = 'desktop',
  own_window_transparent = true,
  own_window_argb_visual = true,
  own_window_argb_value = 0,
  draw_shades = false,
  draw_outline = false,
  draw_borders = false,
  use_xft = true,
  font = 'Inter:size=10',
  xftalpha = 0.92,
  update_interval = 2,
  total_run_times = 0,
  gap_x = 34,
  gap_y = 72,
  minimum_width = 220,
  maximum_width = 260,
  default_color = 'DCE8F5',
  color1 = '00D9FF',
  color2 = '8FA3B8',
  no_buffers = true,
  uppercase = false,
};
conky.text = [[
${font Inter:style=Medium:size=30}${color1}${time %H:%M}${color}
${font Inter:size=10}${color2}${time %A, %d %B}${color}
${voffset 14}${font Inter:style=Medium:size=9}${color1}SYSTEM${color}
${font Inter:size=10}CPU  ${cpu cpu0}%  ${cpubar cpu0 5,110}
RAM  $memperc%  ${membar 5,110}
${font Inter:size=9}${color2}UP $uptime_short${color}
]];
EOF
cat > /var/lib/hardik-os/build-info <<EOF
version=0.8.0
base=debian-trixie
desktop=kde-plasma-6-x11
display-manager=sddm
installer=calamares
boot-splash=hardik-h-energy-ring
dock=plank
desktop-shell=hardik-pyqt6
package-formats=deb,exe,apk
EOF
