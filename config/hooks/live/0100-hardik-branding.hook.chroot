#!/usr/bin/env bash
set -Eeuo pipefail

cat > /etc/os-release <<'EOF'
PRETTY_NAME="HARDIK OS 0.6.0 (Debian 13 Trixie)"
NAME="HARDIK OS"
VERSION="0.6.0"
VERSION_ID="0.6.0"
ID=hardik
ID_LIKE=debian
VERSION_CODENAME=trixie
DEBIAN_CODENAME=trixie
EOF
printf '%s\n' "HARDIK OS 0.6.0 — Debian 13 Trixie • amd64" > /etc/issue

# KDE Plasma 6 desktop defaults.
install -d /etc/skel/.config/autostart /etc/skel/.config/plasma-workspace/env \
  /etc/skel/.config/gtk-3.0 /etc/skel/Desktop \
  /etc/sddm.conf.d /etc/plymouth/themes

cat > /etc/skel/.config/kdeglobals <<'EOF'
[General]
ColorScheme=BreezeDark
Name=HARDIK OS
[KDE]
LookAndFeelPackage=org.kde.breezedark.desktop
[Icons]
Theme=Papirus-Dark
EOF

cat > /etc/skel/.config/kwinrc <<'EOF'
[Compositing]
Enabled=true
Backend=OpenGL
GLCore=true
[Windows]
BorderlessMaximizedWindows=true
EOF

cat > /etc/skel/.config/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-theme-name=Breeze-Dark
gtk-icon-theme-name=Papirus-Dark
gtk-font-name=Inter 10
gtk-cursor-theme-name=Adwaita
EOF

# KDE's own compositor handles transparency, shadows and animations; do not run Picom beside KWin.
cat > /etc/skel/.config/autostart/plank.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK Dock
Exec=plank
EOF
cat > /etc/skel/.config/autostart/conky.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK System Monitor
Exec=conky --config=/etc/xdg/conky/conky.conf
EOF
cat > /usr/local/bin/hardik-set-wallpaper <<'EOF'
#!/bin/sh
sleep 3
if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
  plasma-apply-wallpaperimage /usr/share/backgrounds/hardik-wallpaper.svg || true
fi
EOF
chmod 0755 /usr/local/bin/hardik-set-wallpaper
cat > /etc/skel/.config/autostart/hardik-wallpaper.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK Wallpaper
Exec=/usr/local/bin/hardik-set-wallpaper
EOF

# SDDM starts the Plasma X11 session for broad VM and older-GPU compatibility.
cat > /etc/sddm.conf.d/10-hardik-live.conf <<'EOF'
[Autologin]
User=hardik
Session=plasma.desktop
Relogin=false
EOF
systemctl enable sddm.service
systemctl set-default graphical.target

# Enable the animated Plymouth spinner in the initramfs.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme spinner
  update-initramfs -u -k all
fi

if [ -f /etc/default/ufw ]; then
  sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' /etc/default/ufw
  sed -i 's/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' /etc/default/ufw
  sed -i 's/^DEFAULT_FORWARD_POLICY=.*/DEFAULT_FORWARD_POLICY="DROP"/' /etc/default/ufw
fi
if [ -f /etc/ufw/ufw.conf ]; then sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf; fi
systemctl enable ufw.service apparmor.service auditd.service unattended-upgrades.service
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF
install -d -m 0755 /var/lib/hardik-os
printf '%s\n' "version=0.6.0" "base=debian-trixie" "desktop=kde-plasma-6" "display-manager=sddm" "boot-splash=plymouth-spinner" "dock=plank" "system-monitor=conky" > /var/lib/hardik-os/build-hooks
