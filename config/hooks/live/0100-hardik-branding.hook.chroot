#!/usr/bin/env bash
set -Eeuo pipefail

cat > /etc/os-release <<'EOF'
PRETTY_NAME="HARDIK OS 0.6.0 (Debian 13 Trixie)"
NAME="HARDIK OS"
VERSION="0.6.0"
VERSION_ID="0.6.0"
ID=hardik
ID_LIKE=debian
VERSION_CODENAME=trixie
DEBIAN_CODENAME=trixie
EOF
printf '%s\n' "HARDIK OS 0.6.0 — Debian 13 Trixie • amd64" > /etc/issue

# LXQt user defaults and desktop wallpaper.
install -d /etc/skel/.config/autostart /etc/skel/.config/pcmanfm-qt/lxqt \
  /etc/skel/.config/gtk-3.0 /etc/skel/Desktop /etc/xdg/conky \
  /etc/sddm.conf.d /etc/plymouth/themes

cat > /etc/skel/.config/pcmanfm-qt/lxqt/desktop-items-0.conf <<'EOF'
[Desktop]
Wallpaper=/usr/share/backgrounds/hardik-wallpaper.svg
WallpaperMode=stretch
DesktopBg=#081522
DesktopFg=#e7f8ff
ShowWmMenu=true
EOF

cat > /etc/skel/.config/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-theme-name=Arc-Dark
gtk-icon-theme-name=Papirus-Dark
gtk-font-name=Inter 10
gtk-cursor-theme-name=Adwaita
EOF

cat > /etc/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-theme-name=Arc-Dark
gtk-icon-theme-name=Papirus-Dark
gtk-font-name=Inter 10
gtk-cursor-theme-name=Adwaita
EOF

cat > /etc/xdg/picom.conf <<'EOF'
backend = "xrender";
vsync = true;
shadow = true;
shadow-radius = 18;
shadow-opacity = 0.34;
fading = true;
fade-in-step = 0.035;
fade-out-step = 0.035;
inactive-opacity = 0.94;
active-opacity = 0.98;
EOF

cat > /etc/skel/.config/autostart/plank.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK Dock
Exec=plank
EOF
cat > /etc/skel/.config/autostart/picom.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK Desktop Effects
Exec=picom --config /etc/xdg/picom.conf
EOF
cat > /etc/skel/.config/autostart/conky.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=HARDIK System Monitor
Exec=conky --config=/etc/xdg/conky/conky.conf
EOF

# SDDM provides a real graphical login manager; live-config creates the live user.
cat > /etc/sddm.conf.d/10-hardik-live.conf <<'EOF'
[Autologin]
User=hardik
Session=lxqt.desktop
Relogin=false
EOF
systemctl enable sddm.service

# Animated boot splash. The spinner theme is shipped by plymouth-themes.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme spinner
  update-initramfs -u -k all
fi

if [ -f /etc/default/ufw ]; then
  sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' /etc/default/ufw
  sed -i 's/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' /etc/default/ufw
  sed -i 's/^DEFAULT_FORWARD_POLICY=.*/DEFAULT_FORWARD_POLICY="DROP"/' /etc/default/ufw
fi
if [ -f /etc/ufw/ufw.conf ]; then sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf; fi
systemctl enable ufw.service apparmor.service auditd.service unattended-upgrades.service
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF
install -d -m 0755 /var/lib/hardik-os
printf '%s\n' "version=0.6.0" "base=debian-trixie" "desktop=lxqt" "display-manager=sddm" "boot-splash=plymouth-spinner" > /var/lib/hardik-os/build-hooks
