#!/usr/bin/env bash
set -Eeuo pipefail
install -d /usr/local/sbin /etc/systemd/system
cat > /usr/local/sbin/hardik-waydroid-firstboot <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
if grep -qw 'boot=live' /proc/cmdline || [ -e /run/live/medium ]; then exit 0; fi
if [ -e /var/lib/waydroid/.hardik-initialized ]; then exit 0; fi
if ! grep -qw binderfs /proc/filesystems && ! grep -qw binder /proc/filesystems && [ ! -e /dev/binder ] && [ ! -d /sys/module/binder_linux ]; then
  echo "Waydroid requires kernel Binder support; Android setup will retry later." >&2
  exit 1
fi
modprobe binder_linux devices=binder,hwbinder,vndbinder || modprobe binder_linux
waydroid init
systemctl enable --now waydroid-container.service
install -d /var/lib/waydroid
touch /var/lib/waydroid/.hardik-initialized
EOF
chmod 0755 /usr/local/sbin/hardik-waydroid-firstboot
cat > /etc/systemd/system/hardik-waydroid-firstboot.service <<'EOF'
[Unit]
Description=Initialize mandatory HARDIK OS Android environment
After=network-online.target
Wants=network-online.target
ConditionKernelCommandLine=!boot=live
ConditionPathExists=!/run/live/medium
ConditionPathExists=!/var/lib/waydroid/.hardik-initialized
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hardik-waydroid-firstboot
TimeoutStartSec=0
EOF
cat > /etc/systemd/system/hardik-waydroid-firstboot.timer <<'EOF'
[Unit]
Description=Delayed non-blocking HARDIK OS Android setup
[Timer]
OnBootSec=45s
OnUnitActiveSec=15min
Persistent=true
Unit=hardik-waydroid-firstboot.service
[Install]
WantedBy=timers.target
EOF
systemctl enable hardik-waydroid-firstboot.timer 2>/dev/null || true
