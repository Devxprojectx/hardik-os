#!/usr/bin/python3
"""Translate the legacy live-build rsvg syntax to Noble's rsvg-convert CLI."""
import os
import sys

args = sys.argv[1:]
if len(args) < 2:
    os.execv("/usr/bin/rsvg-convert", ["rsvg-convert", *args])

# Old live-build passes: options..., input.svg, output.png
# Modern librsvg requires: options..., input.svg, -o, output.png
converted = [*args[:-2], args[-2], "-o", args[-1]]
os.execv("/usr/bin/rsvg-convert", ["rsvg-convert", *converted])
